# Code2Chill Environment Variables
# Copy this file to .env.local for local development.
# Obtain actual values from the Supabase Project Dashboard & Vercel Settings.

# Supabase Public Configuration (Protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Only Privileged Key
# NEVER expose through NEXT_PUBLIC_ or commit to version control.
# Used strictly in trusted server operations / seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Event Timezone (Default for Code2Chill events)
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
